PORT=3000
ADMIN_PASSWORD=change-me

# Email de récupération du mot de passe admin (nécessite la config SMTP ci-dessous)
ADMIN_EMAIL=

# Mode maintenance : le site public affiche une page "bientôt en ligne" tant que
# cette variable n'est pas explicitement à "false". MAINTENANCE_BYPASS_KEY (optionnel)
# permet de prévisualiser le site en ajoutant ?key=... à n'importe quelle URL.
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=

# Stockage des données (Upstash Redis / Vercel KV) — obligatoire, y compris en local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stockage des photos (Vercel Blob) — obligatoire, y compris en local
BLOB_READ_WRITE_TOKEN=

# Envoi d'email de confirmation (laisser vide pour désactiver)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Le P'tit Bistro Réunionnais
